{
  "name": "tempo-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/tenant-env.mjs --check",
    "dev:demo": "node scripts/tenant-env.mjs demo -- next dev",
    "build": "node scripts/tenant-env.mjs -- next build",
    "build:demo": "node scripts/tenant-env.mjs demo -- next build",
    "start": "next start",
    "lint": "next lint",
    "check:env": "node scripts/tenant-env.mjs --check",
    "dev:diaconumaria": "node scripts/tenant-env.mjs diaconumaria -- next dev",
    "build:diaconumaria": "node scripts/tenant-env.mjs diaconumaria -- next build",
    "test:tenant": "node --experimental-strip-types --no-warnings scripts/test-tenant.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "test:storage-rules": "node scripts/test-storage-rules.mjs",
    "test:isolation": "npm run test:tenant && npm run test:rules && npm run test:storage-rules",
    "dev:livebetterlife": "node scripts/tenant-env.mjs livebetterlife -- next dev",
    "build:livebetterlife": "node scripts/tenant-env.mjs livebetterlife -- next build",
    "test:parent-link": "node scripts/test-parent-link.mjs",
    "test:platform": "node --experimental-strip-types --no-warnings scripts/test-platform.mjs",
    "test:licence": "node --experimental-strip-types --no-warnings scripts/test-licence.mjs",
    "dev:aicaa": "node scripts/tenant-env.mjs aicaa -- next dev",
    "build:aicaa": "node scripts/tenant-env.mjs aicaa -- next build",
    "test:timestamps": "node --experimental-strip-types --no-warnings scripts/test-timestamps.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "firebase": "^10.8.0",
    "firebase-admin": "^12.7.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.330.0",
    "next": "14.1.0",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^16.5.4",
    "react-markdown": "^9.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
