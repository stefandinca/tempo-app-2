{
  "name": "tempo-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/tenant-env.mjs --check",
    "dev:demo": "node scripts/tenant-env.mjs demo -- next dev",
    "build": "node scripts/tenant-env.mjs -- next build",
    "build:demo": "node scripts/tenant-env.mjs demo -- next build",
    "build:prod": "node scripts/tenant-env.mjs live -- next build",
    "package": "node scripts/build-prod.js",
    "package:demo": "node scripts/build-prod.js --env=demo",
    "package:gzip": "node scripts/build-prod.js --gzip",
    "start": "next start",
    "lint": "next lint",
    "dev:live": "node scripts/tenant-env.mjs live -- next dev",
    "check:env": "node scripts/tenant-env.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "firebase": "^10.8.0",
    "firebase-admin": "^12.7.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.330.0",
    "next": "14.1.0",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^16.5.4",
    "react-markdown": "^9.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
