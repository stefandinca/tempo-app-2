rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      return get(/databases/$(database)/documents/team_members/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/team_members/$(request.auth.uid)) && 
             (getRole() == role || getRole() == role.lower());
    }
    
    // A member switched off in the team UI keeps their role string, so the role
    // helpers alone still let them in. Missing means active: most existing
    // members predate the field, and defaulting a missing value to "inactive"
    // would lock out an entire clinic on deploy.
    //
    // This reads the same team_members document hasRole() already reads, and
    // repeated access to one path inside a single evaluation is cached, so it
    // costs no additional document read.
    function isActiveMember() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/team_members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/team_members/$(request.auth.uid))
               .data.get('isActive', true) != false;
    }

    // Deliberately NOT gated on isActiveMember(). A live clinic's platform
    // account is a Superadmin carrying isActive: false, and gating this would
    // lock the platform out of it. A Superadmin is not deactivatable by this
    // mechanism.
    function isSuperadmin() {
      return hasRole('Superadmin') || hasRole('superadmin');
    }

    // The isSuperadmin() disjunct sits OUTSIDE the isActiveMember() conjunction
    // on purpose — see the note on isSuperadmin(). Do not re-bracket this.
    function isAdmin() {
      return ((hasRole('Admin') || hasRole('admin')) && isActiveMember()) || isSuperadmin();
    }

    function isCoordinator() {
      return (hasRole('Coordinator') || hasRole('coordinator')) && isActiveMember();
    }

    function isTherapist() {
      return (hasRole('Therapist') || hasRole('therapist')) && isActiveMember();
    }
    
    function isParent(clientId) {
      let clientDoc = get(/databases/$(database)/documents/clients/$(clientId));
      return isSignedIn() && (
        request.auth.uid == clientId || 
        (clientDoc != null && 'parentUids' in clientDoc.data && clientDoc.data.parentUids is list && clientDoc.data.parentUids.hasAny([request.auth.uid]))
      );
    }


    // Superadmins can disable specific evaluation protocols per client. Stored as
    // an OPT-OUT list (clients.disabledEvaluations) so an absent field means
    // "everything enabled" — an allowlist would hide every protocol for every
    // existing client the moment these rules deployed.
    // Costs one extra get() per evaluation read; budget is 10 per request.
    // Which evaluation protocols this CLINIC has. Per clinic, not per child:
    // it is a commercial decision about the customer, and one child having CARS
    // while their sibling does not would make no sense.
    //
    // Opt-out, so a clinic with no document has everything enabled. An allowlist
    // would have switched every protocol off for every clinic on deploy.
    function evalDisabled(kind) {
      return exists(/databases/$(database)/documents/system_settings/evaluation_access)
             && get(/databases/$(database)/documents/system_settings/evaluation_access)
                  .data.get('disabled', []).hasAny([kind]);
    }

    // Whether this clinic's licence still permits STAFF WRITES.
    //
    // Fails OPEN: a clinic with no licence document is unrestricted. These
    // rules deploy to every database at once while the mirrors are written per
    // clinic afterwards, so fail-closed would freeze every clinic in the gap.
    //
    // graceEndsAtMillis is epoch milliseconds precisely so this comparison
    // needs no date parsing. null means a lifetime licence.
    //
    // READS ARE NEVER GATED, and neither is anything a parent does. The clinic
    // is the data controller and we are the processor: a billing lapse must not
    // become an outage on a child's clinical record.
    function licenceActive() {
      return !exists(/databases/$(database)/documents/system_settings/licence)
             || get(/databases/$(database)/documents/system_settings/licence)
                  .data.get('graceEndsAtMillis', null) == null
             || request.time.toMillis()
                  < get(/databases/$(database)/documents/system_settings/licence)
                       .data.graceEndsAtMillis;
    }

    // ---- CONTROL PLANE — the (default) database only ----
    // The tenant registry, and the membership mirrors that Storage rules need.
    //
    // Storage rules cannot read a named database (proven by runtime spike), so
    // authorisation for per-tenant Storage paths has to resolve against these.
    // Their firestore.get is a PRIVILEGED read that bypasses these rules — also
    // proven — so locking them to `false` hides them from every client while
    // keeping them usable for authorisation. They must never hold clinical data.
    match /tenants/{tenantId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    // The pricing catalogue: tier names, prices, promises and limits.
    //
    // WORLD-READABLE, deliberately and unusually for this file. The marketing
    // site at tempoapp.ro renders its pricing cards straight from this
    // document, and its visitors are anonymous and not signed in to anything.
    // Everything in it is already published on a public web page — nothing
    // about a clinic, a person or a child is here, and nothing should ever be
    // added that is.
    //
    // Writes go through /api/platform/tiers with the Admin SDK, as the rest of
    // the control plane does, so a browser cannot edit what every clinic is
    // sold.
    match /platform_tiers/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /tenant_members/{memberUid} {
      allow read, write: if false;
    }
    match /tenant_parents/{parentUid} {
      allow read, write: if false;
    }

    // --- Collections ---

    // Staff records carry e-mail, phone and salary. This was readable by ANY
    // signed-in user — and the parent portal runs on anonymous auth, so any
    // visitor could list the whole roster. Parents read /team_public instead.
    match /team_members/{memberId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist();
      // Creates are handled by Cloud Function (Admin SDK) only
      allow create: if false;
      // Admins can update any member; members can update their own doc (e.g., inviteStatus)
      // Only the ADMIN branch is licence-gated. Someone editing their own
      // profile is not the clinic buying anything, and locking a person out of
      // their own record would be a strange thing for an unpaid invoice to do.
      //
      // The self-branch may NOT touch `role` or `isActive`. Without that
      // restriction a Therapist could updateDoc their own document with
      // { role: "superadmin" } — hasRole() accepts the lowercase form — and own
      // a live clinic holding real children's clinical records. That is live
      // enforcement today. `isActive` is not: neither requireStaffRole()
      // (src/lib/serverAuth.ts) nor AuthContext consults it, so deactivating a
      // member does not currently lock them out of anything. It stays
      // denylisted anyway, as hardening ahead of that enforcement existing —
      // so the field cannot already be self-settable on the day something
      // starts reading it.
      //
      // A DENYLIST of these two fields, not an allowlist of the fields we
      // happen to know about, and deliberately so. Self-writes are
      // spread across the settings page (photoURL, name/email/phone/color,
      // language), NotificationPreferences (notificationPreferences) and
      // AuthContext (inviteStatus); an allowlist would break whichever one a
      // future search misses, silently, in production, for a therapist
      // mid-session. Naming only the access fields cannot — everything else
      // keeps working exactly as it does today. `weeklyCapacity` is
      // deliberately absent: it is capacity planning, not access.
      //
      // The admin path (TeamMemberModal, which does write role and isActive)
      // is unaffected — it satisfies the isAdmin() branch before this one.
      // Do not "simplify" this away.
      allow update: if (isAdmin() && licenceActive())
                       || (isSignedIn() && memberId == request.auth.uid
                           && !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['role', 'isActive']));
      allow delete: if isAdmin() && licenceActive();
    }

    match /clients/{clientId} {
      // Staff-only listing. Parent login goes through /client_codes/{CODE}.
      allow list: if isAdmin() || isCoordinator() || isTherapist();
      allow get: if isAdmin() || isCoordinator() || isTherapist() || isParent(clientId);
      allow create: if (isAdmin() || isCoordinator()) && licenceActive();
      // Only a Superadmin may change which evaluations are enabled — Admin and
      // Coordinator have blanket write access to client docs, so without this
      // they could simply re-enable a protocol the Superadmin disabled.
      allow update: if (isSuperadmin() || isAdmin() || isCoordinator()) && licenceActive();
      // NOTE: there used to be a third clause here letting ANY signed-in user add
      // their own uid to parentUids. Anonymous sign-in is open on the parent
      // portal, and most client documents have human-chosen ids of the form
      // firstname + a four-digit birthday, so guessing "adelina2511" was enough to
      // grant yourself that child's records, evaluations, videos and voice notes.
      //
      // Parent linking now goes through /api/parent/link, which resolves the
      // child from the ACCESS CODE with the Admin SDK. Nothing in the browser
      // writes parentUids any more.
      //
      // 🚨 Deploy this only AFTER the app change is live. The old client-side
      // write is still what production runs until then, and tightening this
      // first stops every parent signing in.
      allow delete: if isAdmin() && licenceActive();
    }

    // Display-only mirror of team_members: name, initials, colour, role.
    // Readable by parents (anonymous auth) so the portal can show "your
    // therapist is X". Kept in sync by src/lib/teamPublicSync.ts and the
    // createTeamMember Cloud Function. NEVER put contact details or pay here.
    match /team_public/{memberId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isCoordinator()) && licenceActive();
    }

    // Parent access code -> { clientId, clientName } lookup.
    // Signed-in users (including anonymous parents) can GET a code they already know,
    // but LIST is forbidden so no one can enumerate codes.
    match /client_codes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isCoordinator() || isTherapist();
      allow create, update, delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }

    match /events/{eventId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() ||
                    (isSignedIn() && resource.data.clientId != null && isParent(resource.data.clientId));
      allow create: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow update: if (isAdmin() || isCoordinator() || (isTherapist() && resource.data.therapistId == request.auth.uid)) && licenceActive();
      allow delete: if (isAdmin() || isCoordinator() || (isTherapist() && resource.data.therapistId == request.auth.uid)) && licenceActive();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && licenceActive();
    }

    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }
    
    // system_settings/config holds SmartBill API credentials and the clinic's
    // billing identity. It was readable by ANY signed-in user — and anonymous
    // auth is enabled for the parent portal, so anybody could mint a session and
    // read the invoicing credentials. Split by document:
    //   translations_*  i18n fetches these on every page load, for every user,
    //                   including anonymous parents — must stay broadly readable.
    //   config          staff only.
    // Bug reports from every clinic land in ONE database, so they can be read
    // together instead of scattered per clinic where nobody would look.
    //
    // Written only by /api/report-bug, which uses the Admin SDK and bypasses
    // these rules — nothing may write one from a browser, so a clinic cannot
    // forge a report against another clinic's name.
    match /bug_reports/{reportId} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn() && settingId.matches('translations_.*');
      // Readable by anyone signed in, including parents: it is a list of
      // protocol names, and every view filters itself with it.
      allow read: if isSignedIn() && settingId == 'evaluation_access';
      // World-readable, deliberately: the clinic's logo renders on the login and
      // password-reset screens, where nobody is signed in yet. The document
      // holds a URL to an image that is public by nature and nothing else.
      allow read: if settingId == 'branding';
      allow read: if isAdmin() || isCoordinator() || isTherapist();
      // An Admin runs the clinic, but does not decide what the clinic bought,
      // nor how it is branded, nor what its licence says — all three are ours
      // to set. The licence is the one with teeth: every gate in this file
      // reads system_settings/licence, and licenceActive() fails OPEN on a
      // missing document, so an Admin able to write it could simply delete it
      // and lift every gate at their own expired clinic.
      //
      // Deliberately NOT licence-gated. system_settings has to stay writable
      // while a clinic is expired, or fixing the licence that is blocking them
      // would require the licence that is blocking them. This clause decides
      // WHO may write, not whether a licence is required in order to write —
      // keep those two apart.
      //
      // Costs us nothing: the platform console writes the licence with the
      // Admin SDK (src/app/api/platform/clinics/[id]/licence/route.ts), which
      // bypasses these rules entirely.
      allow write: if (settingId == 'evaluation_access' || settingId == 'branding' || settingId == 'licence')
                     ? isSuperadmin()
                     : isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.clientId != null && isParent(resource.data.clientId));
      allow create: if isAdmin() && licenceActive();
      allow update: if isAdmin() && licenceActive();
      allow delete: if isAdmin() && licenceActive();
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && licenceActive();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        (resource.data.clientId != null && isParent(resource.data.clientId))
      );
      allow create: if isSignedIn() && (
        isAdmin() || isCoordinator() || isTherapist() ||
        (request.resource.data.clientId != null && isParent(request.resource.data.clientId))
      );
      allow update: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        (resource.data.clientId != null && isParent(resource.data.clientId))
      );
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }
    
    match /clients/{clientId}/evaluations/{evalId} {
      allow read: if isSuperadmin()
                    || ((isAdmin() || isCoordinator() || isTherapist() || isParent(clientId))
                        && !evalDisabled('ablls'));
      allow write: if (isSuperadmin()
                       || ((isAdmin() || isCoordinator() || isTherapist())
                           && !evalDisabled('ablls')))
                      && licenceActive();
    }

    match /clients/{clientId}/vbmapp_evaluations/{evalId} {
      allow read: if isSuperadmin()
                    || ((isAdmin() || isCoordinator() || isTherapist() || isParent(clientId))
                        && !evalDisabled('vbmapp'));
      allow write: if (isSuperadmin()
                       || ((isAdmin() || isCoordinator() || isTherapist())
                           && !evalDisabled('vbmapp')))
                      && licenceActive();
    }

    match /clients/{clientId}/portage_evaluations/{evalId} {
      allow read: if isSuperadmin()
                    || ((isAdmin() || isCoordinator() || isTherapist() || isParent(clientId))
                        && !evalDisabled('portage'));
      allow write: if (isSuperadmin()
                       || ((isAdmin() || isCoordinator() || isTherapist())
                           && !evalDisabled('portage')))
                      && licenceActive();
    }

    match /clients/{clientId}/cars_evaluations/{evalId} {
      allow read: if isSuperadmin()
                    || ((isAdmin() || isCoordinator() || isTherapist() || isParent(clientId))
                        && !evalDisabled('cars'));
      allow write: if (isSuperadmin()
                       || ((isAdmin() || isCoordinator() || isTherapist())
                           && !evalDisabled('cars')))
                      && licenceActive();
    }

    match /clients/{clientId}/carolina_evaluations/{evalId} {
      allow read: if isSuperadmin()
                    || ((isAdmin() || isCoordinator() || isTherapist() || isParent(clientId))
                        && !evalDisabled('carolina'));
      allow write: if (isSuperadmin()
                       || ((isAdmin() || isCoordinator() || isTherapist())
                           && !evalDisabled('carolina')))
                      && licenceActive();
    }

    match /clients/{clientId}/interventionPlans/{planId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() || isParent(clientId);
      allow write: if (isAdmin() || isCoordinator()) && licenceActive();
    }

    match /clients/{clientId}/homework/{homeworkId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() || isParent(clientId);
      allow create, delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      // Parents may only toggle completion, not rewrite homework content.
      // The parent branch is NOT gated: a parent has no relationship with our
      // invoice, and ticking off homework must keep working past a lapse.
      allow update: if ((isAdmin() || isCoordinator() || isTherapist()) && licenceActive()) ||
                      (isParent(clientId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt']));
    }

    match /clients/{clientId}/documents/{documentId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() ||
                    (isParent(clientId) && resource.data.sharedWithParent == true);
      allow create: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow update: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }

    // SESSION VIDEOS
    match /clients/{clientId}/videos/{videoId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() ||
                    (isParent(clientId) && resource.data.sharedWithParent == true);
      allow create: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow update: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }

    // VOICE FEEDBACK
    match /clients/{clientId}/voiceFeedback/{feedbackId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() ||
                    (isParent(clientId) && resource.data.sharedWithParent == true);
      allow create: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow update: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }

    match /clients/{clientId}/reports/{reportId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() ||
                    (isParent(clientId) && resource.data.sharedWithParent == true);
      allow create: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow update: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
      allow delete: if (isAdmin() || isCoordinator() || isTherapist()) && licenceActive();
    }

    match /fcm_tokens/{userId} {
      // Reading and REMOVING your own registration stays a client operation:
      // sign-out clears it, and a device that cannot unregister itself keeps
      // receiving notifications for an account nobody is signed into.
      allow read, delete: if isSignedIn() && request.auth.uid == userId;

      // Creating one does NOT. A token belongs to the browser rather than the
      // account, so registering it has to also take it away from whichever
      // account held it before — and a client cannot do that, because this very
      // rule stops one user deleting another user's document.
      //
      // Left as a client write, a second account signing in on a shared device
      // silently ends up holding the same token as the first, and since
      // notification bodies name children, a push meant for one recipient
      // reaches whoever is using that browser. That is not hypothetical: 47
      // registrations across 14 real devices, one token held by 12 accounts.
      //
      // /api/fcm-token writes it with the Admin SDK and clears the older
      // holders in the same request.
      allow create, update: if false;
    }

    // AI consent: each user owns their own consent record.
    match /user_consents/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // AI usage counters are written server-side (Admin SDK) only.
    match /user_ai_usage/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Mira chat history + cost. Written server-side (Admin) only. Readable by the
    // owner; Superadmin can read everyone's for cost oversight.
    match /ai_conversations/{conversationId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperadmin());
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/ai_conversations/$(conversationId)).data.uid == request.auth.uid ||
          isSuperadmin()
        );
        allow write: if false;
      }
    }

    // Per-call AI usage ledger (currently evaluation-insights generations).
    // Written server-side (Admin) only; owner or Superadmin can read.
    match /ai_usage_events/{eventId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperadmin());
      allow write: if false;
    }

    match /threads/{threadId} {
      // `get` is as restricted as `list`: a thread document carries
      // lastMessage.text, participantDetails and clientId, so a permissive get
      // published real message content to any signed-in session — and anonymous
      // auth backs the parent portal, so that meant anybody.
      //
      // `resource == null` is what keeps createOrGetThread working: it checks
      // existence with getDoc() before creating (useChat.ts:264), and a
      // non-existent document carries nothing to leak. A caller can still learn
      // WHETHER a thread exists; it can no longer learn anything that is in it.
      allow get: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        (resource.data.clientId != null && isParent(resource.data.clientId))
      );

      // List threads: only show threads user is part of
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        (resource.data.clientId != null && isParent(resource.data.clientId))
      );

      // Create thread: user must be in participants array
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Update thread: user must be participant or parent
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        (resource.data.clientId != null && isParent(resource.data.clientId))
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants ||
          (get(/databases/$(database)/documents/threads/$(threadId)).data.clientId != null &&
           isParent(get(/databases/$(database)/documents/threads/$(threadId)).data.clientId))
        );
      }
    }

    match /evaluation_protocols/{protocolId=**} {
      allow read: if isAdmin() || isCoordinator() || isTherapist();
      allow write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && licenceActive();
    }

    match /recurring_expenses/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && licenceActive();
    }

    match /potential_clients/{leadId} {
      // Public lead form (unauthenticated) — constrain shape to limit spam/abuse.
      //
      // `createdAt` is REQUIRED. The console's reader
      // (src/app/api/platform/leads/route.ts) orders this collection by
      // createdAt, and Firestore's orderBy silently DROPS documents missing
      // the ordered field — before this line, a create satisfying only the
      // two equality checks below could omit it, and the lead would save yet
      // never appear in the console: no error, no empty row, just absent.
      //
      // String fields are capped individually rather than trusting
      // keys().size() alone: a handful of keys with one enormous string value
      // passes a key-count limit just as easily as a real lead does.
      allow create: if request.resource.data.source == "demo_platform_entry"
                    && request.resource.data.consent == true
                    && request.resource.data.keys().hasAll(['createdAt'])
                    && request.resource.data.keys().size() <= 15
                    && (!('name' in request.resource.data) ||
                        (request.resource.data.name is string && request.resource.data.name.size() <= 200))
                    && (!('email' in request.resource.data) ||
                        (request.resource.data.email is string && request.resource.data.email.size() <= 320))
                    && (!('phone' in request.resource.data) ||
                        (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
                    && (!('clinic' in request.resource.data) ||
                        (request.resource.data.clinic is string && request.resource.data.clinic.size() <= 200));
      allow read, update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      // Staff can read all activities (audit log)
      allow read: if isAdmin() || isCoordinator() || isTherapist();
      // Only staff can create activities (audit trail)
      allow create: if isAdmin() || isCoordinator() || isTherapist();
      // Activities are immutable - no updates or deletes
      allow update, delete: if false;
    }

    // --- Collection Group Rules (required for collectionGroup queries) ---
    
    match /{path=**}/interventionPlans/{planId} {
      allow read: if isAdmin() || isCoordinator() || isTherapist() || 
                  (isSignedIn() && resource.data.clientId != null && isParent(resource.data.clientId));
    }
  }
}